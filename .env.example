# Copy this file to  .env  and fill your MySQL login. Then just run:  python3 app.py
# The database and table are created automatically on first start
# (the MySQL user needs permission to CREATE DATABASE, e.g. root).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=certificate_verify
ADMIN_PASSWORD=choose_a_strong_password
INSTITUTE=Your Institute Name
# BASE_URL=https://verify.yourdomain.com
